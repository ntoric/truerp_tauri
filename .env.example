# Cloud / Docker API base URL for the Next.js app (browser-side).
# When backend runs in Docker on the host port 8088:
NEXT_PUBLIC_API_URL=http://localhost:8088/api/v1

# Optional: proxy /api and /uploads through Next.js (same-origin). Set this and use:
# NEXT_PUBLIC_API_URL=/api/v1
# TRUERP_API_PROXY=http://localhost:8088

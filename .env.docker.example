# Optional overrides for frontend/docker-compose.yml.
# Copy to `.env` next to docker-compose.yml; defaults work without it.
# NOTE: changing these requires `docker compose up --build` (baked at build time).

# Host port the UI is published on.
# WEB_PUBLISH_PORT=3000

# What the browser calls. /api/v1 = same-origin, proxied to TRUERP_API_PROXY.
# NEXT_PUBLIC_API_URL=/api/v1

# Server-side proxy target for /api/*, /uploads/*, /health — reachable from
# inside the container.
#   https://truerp-backend.ntoric.com        (public API)
#   http://host.docker.internal:8088         (backend published on this host)
#   http://truerp-api:8088                   (shared docker network)
# TRUERP_API_PROXY=https://truerp-backend.ntoric.com
